import java.util.*;


public class ConstraintResult {
    private boolean passed;
    private String message;

    public ConstraintResult(boolean passed, String message) {
        this.passed = passed;
        this.message = message;
    }

    public static ConstraintResult pass() {
        return new ConstraintResult(true, "OK");
    }

    public static ConstraintResult fail(String msg) {
        return new ConstraintResult(false, msg);
    }

    public boolean passed() { return passed; }
    public String getMessage() { return message; }
}


public interface Constraint {
    ConstraintResult check(PartialSchedule ps, Section candidate, Student s, Catalog cat);
}


public class PrerequisiteConstraint implements Constraint {
    @Override
    public ConstraintResult check(PartialSchedule ps, Section candidate, Student s, Catalog cat) {
        for (String pre : candidate.getPrerequisites()) {
            if (!s.getCompletedCourses().contains(pre)) {
                return ConstraintResult.fail("Missing prerequisite: " + pre);
            }
        }
        return ConstraintResult.pass();
    }
}


public class CorequisiteConstraint implements Constraint {
    @Override
    public ConstraintResult check(PartialSchedule ps, Section candidate, Student s, Catalog cat) {
        for (String co : candidate.getCorequisites()) {
            boolean hasCourse = s.getCompletedCourses().contains(co) ||
                                ps.containsCourse(co);
            if (!hasCourse) {
                return ConstraintResult.fail("Missing corequisite: " + co);
            }
        }
        return ConstraintResult.pass();
    }
}

public class TimeConflictConstraint implements Constraint {
    @Override
    public ConstraintResult check(PartialSchedule ps, Section candidate, Student s, Catalog cat) {
        for (Section existing : ps.getSections()) {
            if (existing.conflictsWith(candidate)) {
                return ConstraintResult.fail("Time conflict with " + existing.getCourseId());
            }
        }
        return ConstraintResult.pass();
    }
}

public class CreditLoadConstraint implements Constraint {
    private int maxCredits;

    public CreditLoadConstraint(int maxCredits) {
        this.maxCredits = maxCredits;
    }

    @Override
    public ConstraintResult check(PartialSchedule ps, Section candidate, Student s, Catalog cat) {
        int total = ps.getTotalCredits() + candidate.getCredits();
        if (total > maxCredits) {
            return ConstraintResult.fail("Exceeds credit limit (" + maxCredits + ")");
        }
        return ConstraintResult.pass();
    }
}

public class SeatAvailabilityConstraint implements Constraint {
    @Override
    public ConstraintResult check(PartialSchedule ps, Section candidate, Student s, Catalog cat) {
        if (candidate.getSeatsTaken() >= candidate.getSeatCapacity()) {
            return ConstraintResult.fail("No seats available");
        }
        return ConstraintResult.pass();
    }
}

public class ConstraintSuite {
    private List<Constraint> rules = new ArrayList<>();

    public void addConstraint(Constraint c) {
        rules.add(c);
    }

    public ConstraintResult checkAll(PartialSchedule ps, Section candidate, Student s, Catalog cat) {
        for (Constraint c : rules) {
            ConstraintResult r = c.check(ps, candidate, s, cat);
            if (!r.passed()) return r;
        }
        return ConstraintResult.pass();
    }
}

