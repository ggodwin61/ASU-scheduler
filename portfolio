  Scanner input = new Scanner(System.in);
   ArrayList<String[]> people     = Student.studentList();       // Students.txt
   ArrayList<String[]> transcript = Student.transcriptList();    // STUDENTSTRANSCRIPT.txt
   ArrayList<String[]> section    = Sections.sectionList();      // ClassCRN.txt
