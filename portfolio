       public static void listView(StudentSchedule sched) {
          ArrayList<Section> list = sched.getSections();
          for (int i = 0; i < list.size(); i++) {
             Section s = list.get(i);
             System.out.println(s.crn + "   " + s.courseID + "   " + s.days + "   " + s.time);
          }
       }//end of listView
       public static void sortLines(ArrayList<String> lines)  {
          for (int a = 0; a < lines.size() - 1; a++) {
             for (int b = 0; b < lines.size() - 1 - a; b++) {
                if (lines.get(b).compareTo(lines.get(b + 1)) > 0) {
                   String temp = lines.get(b);
                   lines.set(b, lines.get(b + 1));
                   lines.set(b + 1, temp);
                }
             }
          }
       }//end of sortlines

      private static void printDay(StudentSchedule sched, String dayChar, String dayName) {
            ArrayList<Section> list = sched.getSections();
            ArrayList<String> lines = new ArrayList<>();

            for (Section s : list) {
                if (s.days.contains(dayChar)) {
                    String line = s.time + "  " + s.courseID + "  " + s.location;
                    lines.add(line);
                }
            }

            sortLines(lines);
            System.out.println(dayName + ":");
            for (String line : lines) {
                System.out.println("   " + line);
            }
            System.out.println();
        }


   
     //week view
       public static void printWeekView(StudentSchedule sched) {
         printDay(sched, "M", "Monday");
         printDay(sched, "T", "Tuesday");
         printDay(sched, "W", "Wednesday");
         printDay(sched, "R", "Thursday");
         printDay(sched, "F", "Friday");
       }//end of weekView
    }//end of class  printer
 }//end of class asuscheduler

   


    
     

