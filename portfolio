        System.out.println("Student: " + id);

        studentRow = findStudentByID(people, id);

         if (studentRow == null) {
                System.out.println("Student ID not found. Try again.\n");
                  }
               } while (studentRow == null);

            String fname = studentRow[1];
            String lname = studentRow[2];

         StudentSchedule sched = new StudentSchedule(fname, lname, id);

           //group 3 class restrictors
        System.out.println();
           System.out.println("Enter CRN numbers to add classes:(type DONE to stop):");
        System.out.println();
            while (true) {
         System.out.print("CRN: ");
         String crnInput = input.nextLine().trim();

         if (crnInput.equalsIgnoreCase("DONE") || crnInput.length() == 0) {
            break;
         }
         String[] sectionRow = findSectionByCRN(section, crnInput);
         if (sectionRow == null) {
            System.out.println("CRN not found.");

         } else {
            Section s = new Section(sectionRow);
            sched.addSection(s);
            System.out.println("Added: " + s.courseID + "( " + s.crn + ")" + s.days + " " + s.time);
         }
        }

        for (Section s : sched.getSections()) {
           TranscriptWriter.writeTranscript(sched.getStudentID(), s.crn, "IP");
         }

        System.out.println();
        Printer.printSchedule(sched);
       }

        private static String[] findStudentByID(ArrayList<String[]> people, String id) {
        for (String[] row : people) {
            if (row.length > 0 && row[0].equalsIgnoreCase(id)) {
                return row;
            }
        }
        return null;
    }
      private static String[] findSectionByCRN(ArrayList<String[]> section, String crn) {
         for (String[] row : section) {
               if (row.length > 0 && row[0].equalsIgnoreCase(crn)) {
                  return row;
               }
         }
         return null;
      }
         public static class Printer { 
